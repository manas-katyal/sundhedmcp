{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "sundhedmcp",
      "extra-files": [
        "packages/mcp-server/src/mcp.ts",
        { "type": "json", "path": "packages/mcp-server/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/sundhed-client/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/sundhed-session/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
