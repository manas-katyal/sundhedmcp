{
  "name": "sundhedmcp",
  "version": "0.2.0",
  "description": "SundhedMCP: local, read-only MCP server that lets your AI read your own sundhed.dk record (medicine card, prescriptions, test results, vaccinations, referrals) after you log in with MitID",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "sundhed.dk",
    "medicinkort",
    "mitid",
    "health",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/stdio.ts",
    "serve": "node src/serve.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist/lib && tsc -p tsconfig.build.json && cp -R src/assets dist/lib/assets",
    "prepublishOnly": "pnpm build && pnpm test",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "playwright-core": "^1.56.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "typescript": "^5.8.0"
  },
  "bin": {
    "sundhedmcp": "bin/sundhedmcp.js"
  },
  "files": [
    "bin",
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manas-katyal/sundhedmcp.git"
  },
  "homepage": "https://sundhedmcp.dk",
  "packageManager": "pnpm@12.21.0"
}
