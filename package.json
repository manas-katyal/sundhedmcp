{
  "name": "sundhedmcp-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Workspace for SundhedMCP. The published package is packages/mcp-server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node packages/mcp-server/src/stdio.ts",
    "serve": "node packages/mcp-server/src/serve.ts",
    "test": "node --test 'packages/*/test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter sundhedmcp build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manas-katyal/sundhedmcp.git"
  },
  "homepage": "https://sundhedmcp.dk",
  "packageManager": "pnpm@12.21.0"
}
