{
  "name": "sundhedmcp",
  "version": "0.2.0",
  "description": "SundhedMCP: local, read-only MCP server that lets your AI read your own sundhed.dk record (medicine card, prescriptions, test results, vaccinations, referrals) after you log in with MitID",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "sundhed.dk",
    "medicinkort",
    "mitid",
    "health",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.ts",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "prepublishOnly": "pnpm build && pnpm --dir ../.. test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "playwright-core": "^1.56.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sundhedmcp/client": "workspace:*",
    "@sundhedmcp/session": "workspace:*",
    "esbuild": "^0.28.0"
  },
  "bin": {
    "sundhedmcp": "bin/sundhedmcp.js"
  },
  "files": [
    "bin",
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manas-katyal/sundhedmcp.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://sundhedmcp.dk"
}
